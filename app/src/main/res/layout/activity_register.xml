<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registerScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1D493A"
    android:fillViewport="true"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:id="@+id/registerRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="MEMBER ONBOARDING"
            android:textColor="#A5D6A7"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/registerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="Create Account"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="Join Kisii &amp; Nyamira residents protecting our hills, rivers, and wetlands."
            android:textColor="#A5D6A7"
            android:textSize="14sp" />

        <!-- Name -->
        <EditText
            android:id="@+id/regNameInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:autofillHints="name"
            android:background="#FFFFFF"
            android:fontFamily="monospace"
            android:hint="Full Name"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="16dp"
            android:textColor="#1A1C1E"
            android:textColorHint="#757575"
            android:textSize="15sp" />

        <!-- Email -->
        <EditText
            android:id="@+id/regEmailInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:autofillHints="emailAddress"
            android:background="#FFFFFF"
            android:fontFamily="monospace"
            android:hint="Email Address"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="#1A1C1E"
            android:textColorHint="#757575"
            android:textSize="15sp" />

        <!-- Password -->
        <EditText
            android:id="@+id/regPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:background="#FFFFFF"
            android:fontFamily="monospace"
            android:hint="Create Password (min 6 chars)"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="#1A1C1E"
            android:textColorHint="#757575"
            android:textSize="15sp" />

        <!-- Phone -->
        <EditText
            android:id="@+id/regPhoneInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:autofillHints="phone"
            android:background="#FFFFFF"
            android:fontFamily="monospace"
            android:hint="Phone Number (e.g., 0712345678)"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="#1A1C1E"
            android:textColorHint="#757575"
            android:textSize="15sp" />

        <!-- County -->
        <EditText
            android:id="@+id/regCountyInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:autofillHints="postalAddress"
            android:background="#FFFFFF"
            android:fontFamily="monospace"
            android:hint="County (e.g., Kisii or Nyamira)"
            android:imeOptions="actionNext"
            android:inputType="textCapWords"
            android:paddingHorizontal="16dp"
            android:textColor="#1A1C1E"
            android:textColorHint="#757575"
            android:textSize="15sp" />

        <!-- Sub-County -->
        <EditText
            android:id="@+id/regSubCountyInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:autofillHints="postalAddress"
            android:background="#FFFFFF"
            android:fontFamily="monospace"
            android:hint="Sub-County (e.g., Kitutu Chache South)"
            android:imeOptions="actionNext"
            android:inputType="textCapWords"
            android:paddingHorizontal="16dp"
            android:textColor="#1A1C1E"
            android:textColorHint="#757575"
            android:textSize="15sp" />

        <!-- Ward -->
        <EditText
            android:id="@+id/regWardInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:autofillHints="postalAddress"
            android:background="#FFFFFF"
            android:fontFamily="monospace"
            android:hint="Ward (e.g., Bogusero)"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:paddingHorizontal="16dp"
            android:textColor="#1A1C1E"
            android:textColorHint="#757575"
            android:textSize="15sp" />

        <!-- Register Button -->
        <Button
            android:id="@+id/createAccountButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2E7D32"
            android:fontFamily="sans-serif-medium"
            android:text="Register Account"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- Already have an account link -->
        <TextView
            android:id="@+id/alreadyHaveAccountLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="28dp"
            android:fontFamily="sans-serif"
            android:padding="8dp"
            android:text="Already have an account? Login here"
            android:textColor="#A5D6A7"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
