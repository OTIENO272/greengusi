<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/leaderboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1D493A"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".LeaderboardActivity">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:text="COMMUNITY CONSERVATION CHALLENGE"
        android:textColor="#A5D6A7"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="Ward vs Ward Leaderboard"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/userWardBadgeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="Your Ward: Bogusero | Community Rank: #1"
        android:textColor="#C8E6C9"
        android:textSize="13sp" />

    <!-- Leaderboard Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/leaderboardListLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!-- Share Ward Challenge Button -->
    <Button
        android:id="@+id/shareLeaderboardButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#2E7D32"
        android:fontFamily="sans-serif-medium"
        android:text="📣 Rally Your Ward on WhatsApp"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <Button
        android:id="@+id/leaderboardBackToHubButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#264D3F"
        android:fontFamily="sans-serif"
        android:text="← Back to Action Hub"
        android:textAllCaps="false"
        android:textColor="#A5D6A7"
        android:textSize="14sp" />

</LinearLayout>
