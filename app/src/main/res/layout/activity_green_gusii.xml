<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hubScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1D493A"
    android:fillViewport="true"
    tools:context=".GreenGusiiActivity">

    <LinearLayout
        android:id="@+id/hubRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Language Switcher Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/langEnButton"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#264D3F"
                android:text="🇬🇧 English"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/langSwButton"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#264D3F"
                android:text="🇰🇪 Swahili"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/langGusiiButton"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="#264D3F"
                android:text="🌿 Ekegusii"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Header -->
        <TextView
            android:id="@+id/hubHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="GREEN GUSII ACTION HUB"
            android:textColor="#A5D6A7"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/hubWelcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="Welcome, Champion!"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hubLocationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="Ward: Bogusero | Kitutu Chache South, Kisii"
            android:textColor="#C8E6C9"
            android:textSize="14sp" />

        <!-- Seasonal Rainfall & Planting Advisory Card -->
        <LinearLayout
            android:id="@+id/seasonalAlertCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#15362A"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/seasonalAlertTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="🌧️ Planting &amp; Rainfall Season"
                    android:textColor="#80CBC4"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/seasonBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2E7D32"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="OPTIMAL"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/seasonalAlertBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="Soil moisture in Gusii highlands is primed for transplanting Grevillea and Hass Avocado seedlings."
                android:textColor="#E0F2F1"
                android:textSize="13sp" />

            <Button
                android:id="@+id/triggerNotificationButton"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#00796B"
                android:text="🔔 Test Seasonal Planting Notification"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Eco-Impact Tracker Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E8F5E9"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/ecoTrackerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="🌿 Live Eco-Impact Tracker"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pointsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="Impact: 0 / 500 pts"
                    android:textColor="#1A1C1E"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rankBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1B5E20"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="New Member"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/ecoProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:max="500"
                android:progress="0"
                android:progressTint="#1B5E20" />

            <TextView
                android:id="@+id/pledgesPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="Check off your local environmental pledges:"
                android:textColor="#2E7D32"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/pledge1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="#1B5E20"
                android:text="Plant indigenous trees along riverbanks (+100 pts)"
                android:textColor="#1A1C1E"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/pledge2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#1B5E20"
                android:text="Avoid / replace Eucalyptus within 30m of springs (+100 pts)"
                android:textColor="#1A1C1E"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/pledge3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#1B5E20"
                android:text="Practice terracing &amp; compost manuring in tea/coffee (+100 pts)"
                android:textColor="#1A1C1E"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/pledge4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#1B5E20"
                android:text="Participate in community wetland &amp; stream cleanups (+100 pts)"
                android:textColor="#1A1C1E"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/pledge5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#1B5E20"
                android:text="Report waste dumping or hazardous encroachments (+100 pts)"
                android:textColor="#1A1C1E"
                android:textSize="13sp" />

            <!-- Digital Certificate Button (Highlighted when 500 pts reached) -->
            <Button
                android:id="@+id/shareCertificateButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#D4AF37"
                android:fontFamily="sans-serif-medium"
                android:text="🏆 View &amp; Share Green Champion Certificate"
                android:textAllCaps="false"
                android:textColor="#1A1C1E"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Field Tools Navigation -->
        <TextView
            android:id="@+id/fieldToolsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="COMMUNITY FIELD TOOLS"
            android:textColor="#A5D6A7"
            android:textSize="12sp" />

        <!-- Button: Report Hazard (with GPS & Camera) -->
        <Button
            android:id="@+id/openReportToolButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#C62828"
            android:fontFamily="sans-serif-medium"
            android:text="🚨 Report Hazard (Camera &amp; GPS)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Button: Tree Planner -->
        <Button
            android:id="@+id/openTreePlannerButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#2E7D32"
            android:fontFamily="sans-serif-medium"
            android:text="🌲 Highland Agroforestry Tree Planner"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Button: Verified Nurseries Directory -->
        <Button
            android:id="@+id/openNurseryDirectoryButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#00897B"
            android:fontFamily="sans-serif-medium"
            android:text="🌱 Kisii &amp; Nyamira Seedling Nurseries"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Button: Ward vs Ward Leaderboard -->
        <Button
            android:id="@+id/openLeaderboardButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1565C0"
            android:fontFamily="sans-serif-medium"
            android:text="🏆 Ward vs Ward Green Leaderboard"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Update Profile option -->
        <Button
            android:id="@+id/editProfileButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#264D3F"
            android:fontFamily="sans-serif"
            android:text="← Update Registration Profile"
            android:textAllCaps="false"
            android:textColor="#A5D6A7"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
